# Residential proxy for bot-protected sites (Akamai, Cloudflare)
# PROXY_URL=http://user:pass@host:port

# ── Search ────────────────────────────────────────────
# Primary engine for /v1/search: google (default, stealth browser) or duckduckgo
# SEARCH_ENGINE=google
# Try the other engine when the primary is CAPTCHA-blocked or returns nothing
# SEARCH_FALLBACK=true
# Cache identical searches for this long (0 disables)
# SEARCH_CACHE_TTL_SECONDS=3600

# ── Performance ───────────────────────────────────────
# Parallel Chromium contexts for browser mode and Google search
# BROWSER_POOL_SIZE=3
# Worker threads for HTML → markdown (default: CPU count - 1, max 4; 0 = main thread)
# EXTRACT_WORKERS=
# API requests per minute per client
# RATE_LIMIT_MAX=60
# Parallel crawl jobs, and max crawl jobs started per second (0 = unlimited)
# CRAWL_CONCURRENCY=10
# CRAWL_RATE_PER_SEC=10
